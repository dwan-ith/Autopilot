# AUTOPILOT configuration
#
# Connector modes:
# - required: needed for normal autonomous reasoning or secure deployment.
# - optional: enables a richer/live integration, but the product has a fallback.
# - account: requires a user/team OAuth or API-key connection for real side effects.

# Core runtime
AUTOPILOT_API_KEY=
AUTOPILOT_WEBHOOK_SECRET=
AUTOPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTOPILOT_SIGNAL_RATE_LIMIT=30
AUTOPILOT_DISABLE_LLM=0
AUTOPILOT_LLM_RETRIES=2
AUTOPILOT_LLM_BAD_SLOT_COOLDOWN_SECONDS=900
AUTOPILOT_MISSION_TIMEOUT_SECONDS=900
AUTOPILOT_AUTO_CONNECT_DEMO=1
AUTOPILOT_PERSISTENT_MONITORING=0
AUTOPILOT_MONITOR_INTERVAL_SECONDS=300

# LLM providers (at least one recommended; tests can run with AUTOPILOT_DISABLE_LLM=1)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Optional Omium tracing
# Official SDK path: pip install ".[omium]" then set OMIUM_SDK_INIT=1.
# Custom HTTP relay path: set OMIUM_HTTP_INGEST_URL to your own relay endpoint.
OMIUM_API_KEY=
OMIUM_SDK_INIT=0
OMIUM_PROJECT=autopilot
OMIUM_API_URL=
OMIUM_HTTP_INGEST_URL=
OMIUM_DEBUG=0

# Web/search/read connectors
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=
SENTRY_TOKEN=
SENTRY_ORG=
PAGERDUTY_TOKEN=

# Action/account connectors
SLACK_WEBHOOK_URL=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Google OAuth connectors: Gmail + Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTOPILOT_OAUTH_REDIRECT_URI=http://localhost:8090/oauth/callback/google

# Cloud/demo action connector
DEPLOYMENT_WEBHOOK_URL=
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_ID=
