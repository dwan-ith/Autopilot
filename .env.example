# AUTOPILOT environment configuration

# Optional LLM providers. If neither is set, deterministic heuristics are used.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional live search and notifications.
TAVILY_API_KEY=
SLACK_WEBHOOK_URL=

# Project management scope: Linear is implemented; Jira remains a config stub.
PROJECT_MGMT_PROVIDER=linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Cloud infra scope: one demoable deployment trigger.
DEPLOYMENT_WEBHOOK_URL=
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_REF=main
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_ID=

# Optional tracing bonus.
OMIUM_API_KEY=

# Force offline deterministic mode even if provider keys are present.
AUTOPILOT_DISABLE_LLM=0
