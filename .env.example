# Example .env for AUTOPILOT
# Copy this file to `.env` and fill values as appropriate.

# GitHub (required for GitHubAgent functionality)
# Use a fine-grained personal access token or GitHub App installation token.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Redis (optional hot cache)
REDIS_URL=redis://localhost:6379/0

# Postgres DSN (optional durable store)
POSTGRES_DSN=postgresql://user:password@localhost:5432/autopilot

# Notification connectors
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# SQLite override (optional)
SQLITE_PATH=
TAVILY_API_KEY=
SLACK_WEBHOOK_URL=
OMIUM_API_KEY=
NOTION_TOKEN=
CONFLUENCE_TOKEN=
JIRA_URL=
JIRA_TOKEN=
LINEAR_TOKEN=
AWS_PROFILE=
GCP_PROJECT=
AZURE_SUBSCRIPTION_ID=
GITHUB_WEBHOOK_SECRET=
