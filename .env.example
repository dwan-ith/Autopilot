# AUTOPILOT — Environment Configuration
# Copy this file to .env and fill in the values you have.
#
# LLM Provider (at least one required for real reasoning):
#   AUTOPILOT will auto-detect: OpenRouter is tried first, then Groq.
#   Without either key, operators fall back to deterministic heuristics.

# Option A — OpenRouter (recommended, gives access to Gemini / Claude / GPT)
OPENROUTER_API_KEY=sk-or-v1-...

# Option B — Groq (free tier, fast, Llama-3.3-70b)
GROQ_API_KEY=gsk_...

# Optional integrations (system works without these):
TAVILY_API_KEY=tvly-...         # Live web search in the Knowledge connector
SLACK_WEBHOOK_URL=https://...   # Slack notification delivery
OMIUM_API_KEY=                  # Omium tracing bonus (leave blank to use local trace)
