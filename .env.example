# Backend
AUTOPILOT_PORT=8090
AUTOPILOT_API_KEY=
AUTOPILOT_WEBHOOK_SECRET=
AUTOPILOT_SIGNAL_RATE_LIMIT=30
AUTOPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo/runtime switches
AUTOPILOT_DISABLE_LLM=1
AUTOPILOT_AUTO_APPROVE_ACTIONS=false
AUTOPILOT_AUTO_CONNECT_DEMO=false
AUTOPILOT_MEMORY_KEEP_PER_KEY=500

# LLM providers, optional. If unset, AUTOPILOT runs in heuristic mode.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
AUTOPILOT_LLM_RETRIES=2

# Google OAuth2, optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTOPILOT_OAUTH_REDIRECT_URI=http://localhost:8090/oauth/callback/google

# Connector credentials, optional.
GITHUB_TOKEN=
GITHUB_REPO=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
NOTION_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SLACK_WEBHOOK_URL=

# Outbound actions, optional.
AUTOPILOT_CALLBACK_URL=
DEPLOYMENT_WEBHOOK_URL=
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_REF=main
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_ID=
