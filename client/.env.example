# Dashboard-related vars can live in either place — both are loaded; `client/.env` overrides repo root on duplicates:
#   - Repo-root `.env` (same file as `run_server.py`)
#   - `client/.env`
#
# You do not need `client/.env.local` unless you want gitignored overrides.
#
# Optional keys:
#
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_AUTOPILOT_API_KEY=   # same as AUTOPILOT_API_KEY when the API requires auth
# AUTOPILOT_API_ORIGIN=http://127.0.0.1:8090
