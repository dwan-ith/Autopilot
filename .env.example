# AUTOPILOT environment configuration

# Optional LLM providers. If neither is set, deterministic heuristics are used.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional live search and notifications.
TAVILY_API_KEY=
SLACK_WEBHOOK_URL=

# Optional tracing bonus.
OMIUM_API_KEY=

# Force offline deterministic mode even if provider keys are present.
AUTOPILOT_DISABLE_LLM=0
