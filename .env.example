# AUTOPILOT configuration
#
# Connector modes:
# - required: needed for normal autonomous reasoning or secure deployment.
# - optional: enables a richer/live integration, but the product has a fallback.
# - account: requires a user/team OAuth or API-key connection for real side effects.

# Core runtime
AUTOPILOT_HOST=127.0.0.1
AUTOPILOT_API_KEY=
AUTOPILOT_WEBHOOK_SECRET=
AUTOPILOT_OAUTH_STATE_SECRET=
AUTOPILOT_CREDENTIAL_ENCRYPTION_KEY=
AUTOPILOT_PUBLIC_URL=
AUTOPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTOPILOT_SIGNAL_RATE_LIMIT=30
AUTOPILOT_DISABLE_LLM=0
AUTOPILOT_LLM_RETRIES=2
AUTOPILOT_LLM_TIMEOUT_SECONDS=30
AUTOPILOT_LLM_MAX_RETRY_DELAY_SECONDS=2
AUTOPILOT_LLM_BAD_SLOT_COOLDOWN_SECONDS=900
AUTOPILOT_LLM_RATE_LIMIT_COOLDOWN_SECONDS=90
AUTOPILOT_PROVIDER_PREFLIGHT_ON_STARTUP=0
AUTOPILOT_PROVIDER_HEALTH_PATH=
AUTOPILOT_MISSION_TIMEOUT_SECONDS=900
AUTOPILOT_AUTO_CONNECT_DEMO=0
AUTOPILOT_PERSISTENT_MONITORING=0
AUTOPILOT_MONITOR_INTERVAL_SECONDS=300

# LLM providers (at least one recommended; tests can run with AUTOPILOT_DISABLE_LLM=1)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
AUTOPILOT_GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
AUTOPILOT_OPENROUTER_MODEL=openrouter/free

# Optional Omium tracing
# Official SDK path: pip install ".[omium]" then set OMIUM_SDK_INIT=1.
# Custom HTTP relay path: set OMIUM_HTTP_INGEST_URL to your own relay endpoint.
OMIUM_API_KEY=
OMIUM_SDK_INIT=0
OMIUM_TRACING=1
OMIUM_CHECKPOINTS=1
OMIUM_PROJECT=autopilot

# MCP server configuration (defaults to data/mcp_servers.json)
# AUTOPILOT_MCP_CONFIG=C:\path\to\mcp_servers.json
# Use a separate key for remote MCP clients, or leave blank to reuse AUTOPILOT_API_KEY.
AUTOPILOT_MCP_API_KEY=
# Add the exact public host when publishing MCP, e.g. api.example.com.
AUTOPILOT_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
AUTOPILOT_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
OMIUM_API_URL=
OMIUM_HTTP_INGEST_URL=
OMIUM_DEBUG=0

# Web/search/read connectors
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
PAGERDUTY_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_ID=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_ACCESS_TOKEN=
SLACK_DEFAULT_CHANNEL=

# ── Linear ────────────────────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# ── Google OAuth2 (Gmail + Google Drive) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTOPILOT_OAUTH_REDIRECT_URI=http://localhost:8090/oauth/callback/google

# Cloud/demo action connector
DEPLOYMENT_WEBHOOK_URL=
